{
  "name": "querycraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "node scripts/test-db/load-tests.mjs",
    "test-db:migrate": "node scripts/test-db/migrate.mjs up",
    "test-db:migrate:status": "node scripts/test-db/migrate.mjs status",
    "test-db:migrate:down": "node scripts/test-db/migrate.mjs down",
    "test-db:migrate:down:all": "node scripts/test-db/migrate.mjs down --all",
    "typecheck": "tsc --noEmit",
    "sync:sql-wasm": "node scripts/sync-sql-wasm.mjs",
    "postinstall": "npm run sync:sql-wasm"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@faker-js/faker": "^10.6.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "framer-motion": "^14.6.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-select": "^5.10.2",
    "read-excel-file": "^9.3.12",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
